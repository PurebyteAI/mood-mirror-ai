# Copy this file to .env and set values before running docker compose.

# Groq (required for AI analysis + STT)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional speech-to-text / voice features
RIME_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional image generation service
IMAGE_API_URL=
IMAGE_API_BEARER_TOKEN=
