# Copy this file to .env and set values before running docker compose.

# OpenRouter (required for AI analysis)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional speech-to-text / voice features
GROQ_API_KEY=
RIME_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional image generation service
IMAGE_API_URL=
IMAGE_API_BEARER_TOKEN=
